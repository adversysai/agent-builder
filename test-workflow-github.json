        "mcpAction": "search_code",
        "mcpParams": {
          "q": "openai repo:{{input.repo}}"
        }
      }
    },
    {
      "id": "end",
      "type": "end",
      "data": {
        "nodeType": "end",
        "label": "End",
        "nodeName": "End"
