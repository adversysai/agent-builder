    },
    {
      "id": "e3",
      "source": "discover-repo",
      "target": "search-api-keys"
    },
    {
      "id": "e4",
      "source": "search-ai-frameworks",
      "target": "search-models"
    },
    {
      "id": "e5",
      "source": "search-api-keys",
      "target": "search-mcp-agents"
    },
    {
      "id": "e6",
      "source": "search-models",
      "target": "ai-analysis"
    },
    {
      "id": "e7",
      "source": "search-mcp-agents",
      "target": "ai-analysis"
    },
    {
      "id": "e8",
      "source": "ai-analysis",
      "target": "end"
    }
  ]
}
